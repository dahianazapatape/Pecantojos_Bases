{
  "name": "pecantojos-mongo",
  "version": "3.0.0",
  "description": "Pecantojos: tienda en línea de galletas artesanales sobre MongoDB Atlas — Proyecto final Bases de Datos II",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "demo": "node src/server.js --demo",
    "mongo:check": "node src/db/mongo-check.js",
    "mongo:preparar": "node src/db/mongo-check.js --preparar",
    "mongo:cargar": "node src/db/cargar-datos.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec \"tests/integration/*.test.js\"",
    "test:mongo": "node --test --test-reporter=spec \"tests/integration/*mongo*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
