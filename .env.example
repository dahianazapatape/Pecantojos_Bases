# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub (.gitignore).

# ---------- Servidor ----------
PORT=3000

# ---------- Base de datos ----------
# mongo  = MongoDB Atlas (base de datos en la nube)
# memory = datos en memoria (solo para pruebas; también: npm run demo)
DB_CLIENT=mongo

# ---------- MongoDB Atlas ----------
# Atlas > tu cluster > Connect > Drivers > Node.js. Reemplaza <usuario> y <contraseña>.
# Si la contraseña tiene caracteres como @ : / ? # % escríbelos codificados (@ = %40, # = %23, % = %25)
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=pecantojos
MONGODB_DB=pecantojos

# Contraseña de la administradora (usuario: admin) que usa "npm run mongo:cargar". Mínimo 8 caracteres.
ADMIN_PASSWORD=

# ---------- Seguridad ----------
# Cadena larga y aleatoria; no la compartas ni la subas al repositorio
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES=8h

# ---------- Negocio ----------
WHATSAPP_NUMERO=573000000000

# ---------- Nube (opcional) ----------
# En Azure App Service usa /home/data/uploads para que las fotos no se borren al publicar
# UPLOADS_DIR=
